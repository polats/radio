# API
PORT=4000
DATABASE_URL=postgresql://user:pass@localhost:5432/radio

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# Audio Storage (Railway Buckets - S3 compatible)
# These are auto-injected by Railway when you add a Bucket service
# For local dev, leave empty to use filesystem storage
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://storage.railway.app
S3_REGION=auto

# Local dev audio storage (used when S3 is not configured)
AUDIO_DIR=/data/audio
