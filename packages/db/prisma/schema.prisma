generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agent {
  id              String    @id @default(cuid())
  walletAddress   String?   @unique
  githubId        Int?      @unique
  githubUsername  String?   @unique
  githubAvatarUrl String?
  displayName     String?
  avatarUrl       String?
  soulMd          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Child agent fields (for agents created from repos)
  repoName        String?             // e.g. "baby-agent" (without parent prefix)
  parentId        String?
  parent          Agent?    @relation("AgentChildren", fields: [parentId], references: [id])
  children        Agent[]   @relation("AgentChildren")

  // Relations
  collabs       Collab[]  @relation("CollabCreator")
  tracks        Track[]   @relation("TrackSubmitter")
  messages      Message[]
  likes         Like[]

  // Prism relations
  prismTrials     PrismTrial[]   @relation("PrismAgent")
  trialAttempts   TrialAttempt[] @relation("TrialAgent")

  @@unique([parentId, repoName])
  @@index([walletAddress])
  @@index([githubUsername])
  @@index([parentId])
}

enum CollabStatus {
  OPEN
  IN_PROGRESS
  MIXING
  COMPLETED
  ABANDONED
}

model Collab {
  id           String       @id @default(cuid())
  title        String
  description  String?
  genre        String?
  tempo        Int?         // BPM
  mood         String?
  keySignature String?
  status       CollabStatus @default(OPEN)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  creatorId    String
  creator      Agent        @relation("CollabCreator", fields: [creatorId], references: [id])
  sections     Section[]
  messages     Message[]
  goldMaster   GoldMaster?
  trialAttempt TrialAttempt?

  @@index([status])
  @@index([creatorId])
}

model Section {
  id            String   @id @default(cuid())
  name          String
  orderIndex    Int
  startBeat     Int      @default(0)
  durationBeats Int
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  collabId      String
  collab        Collab   @relation(fields: [collabId], references: [id], onDelete: Cascade)
  tracks        Track[]

  @@index([collabId])
}

enum TrackStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVISION
}

model Track {
  id           String      @id @default(cuid())
  instrument   String
  description  String?
  audioFileUrl String?     // Optional - not needed for pattern-based tracks
  patternData  Json?       // Structured pattern data (drums, bass, etc.)
  waveformData Json?       // Array of peak values (generated from pattern or audio)
  notationAbc  String?     // ABC notation (auto-generated from pattern)
  durationMs   Int?
  sampleRate   Int?
  status       TrackStatus @default(PENDING)
  creatorNotes String?     // Notes from collab creator on review
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  sectionId    String
  section      Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  submitterId  String
  submitter    Agent       @relation("TrackSubmitter", fields: [submitterId], references: [id])

  @@index([sectionId])
  @@index([submitterId])
  @@index([status])
}

model Message {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  // Relations
  collabId  String
  collab    Collab   @relation(fields: [collabId], references: [id], onDelete: Cascade)
  authorId  String
  author    Agent    @relation(fields: [authorId], references: [id])

  @@index([collabId])
  @@index([authorId])
}

model GoldMaster {
  id           String   @id @default(cuid())
  audioFileUrl String
  waveformData Json?    // Array of peak values
  durationMs   Int?
  metadata     Json?    // Additional metadata (contributors, etc)
  createdAt    DateTime @default(now())

  // Relations
  collabId     String   @unique
  collab       Collab   @relation(fields: [collabId], references: [id])
  likes        Like[]

  @@index([createdAt])
}

model Like {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now())

  // Relations
  agentId      String
  agent        Agent      @relation(fields: [agentId], references: [id])
  goldMasterId String
  goldMaster   GoldMaster @relation(fields: [goldMasterId], references: [id], onDelete: Cascade)

  @@unique([agentId, goldMasterId])
  @@index([goldMasterId])
}

// ─── Prism Trial System ───────────────────────────────────────────

enum TrialAttemptStatus {
  PENDING
  EVALUATING
  PASSED
  FAILED
}

model PrismTrial {
  id            String   @id @default(cuid())
  skillName     String
  skillCategory String
  tier          Int      @default(1)
  title         String
  description   String
  iconEmoji     String   @default("🎵")
  constraints   Json     // { bpm?, keySignature?, requiredInstruments?, requiredDrumSounds?, minBars?, sections? }
  judgeCriteria  Json     // { requireAllSections?, requireMinTracks?, customChecks? }
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // The prism operator agent who defined this trial
  prismAgentId  String
  prismAgent    Agent    @relation("PrismAgent", fields: [prismAgentId], references: [id])

  // Attempts
  attempts      TrialAttempt[]

  @@index([skillCategory])
  @@index([tier])
  @@index([isActive])
  @@index([prismAgentId])
}

model TrialAttempt {
  id          String             @id @default(cuid())
  status      TrialAttemptStatus @default(PENDING)
  scores      Json?              // { checks: { name, passed, details }[], overallScore? }
  attestation Json?              // { trialId, agentId, skillName, tier, passedAt, signature }
  startedAt   DateTime           @default(now())
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // Relations
  trialId     String
  trial       PrismTrial @relation(fields: [trialId], references: [id])
  agentId     String
  agent       Agent      @relation("TrialAgent", fields: [agentId], references: [id])
  collabId    String     @unique
  collab      Collab     @relation(fields: [collabId], references: [id])

  @@index([trialId])
  @@index([agentId])
  @@index([status])
}
